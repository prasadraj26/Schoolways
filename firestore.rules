rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Reusable function to get user role
    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    // Only authenticated users can access the database generally
    match /{document=**} {
      allow read, write: if false; // Deny by default
    }

    // USERS
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId; // Users can edit their own profile
    }

    // STUDENTS
    match /students/{studentId} {
      // Admins and teachers can read all students
      // Parents can only read their own child's data
      allow read: if request.auth != null && (
        getUserRole() == 'admin' || 
        getUserRole() == 'teacher' || 
        (getUserRole() == 'parent' && resource.data.parentId == request.auth.uid)
      );
      // Only admins can modify students
      allow write: if request.auth != null && getUserRole() == 'admin';
    }

    // CLASSES
    match /classes/{classId} {
      allow read: if request.auth != null; // Everyone can see classes
      allow write: if request.auth != null && getUserRole() == 'admin';
    }

    // ATTENDANCE (Collection Group or subcollection)
    match /attendance/{attendanceId} {
      allow read: if request.auth != null;
      // Admins and Teachers can mark attendance
      allow write: if request.auth != null && (getUserRole() == 'admin' || getUserRole() == 'teacher');
    }

    // NOTIFICATIONS
    match /notifications/{notificationId} {
      // Users can read if it's targeted to 'all' or to their specific role/uid
      allow read: if request.auth != null && (
        resource.data.targetRole == 'all' || 
        resource.data.targetRole == getUserRole() ||
        resource.data.targetId == request.auth.uid
      );
      // Admins can create notifications
      allow write: if request.auth != null && getUserRole() == 'admin';
    }
    
    // TEACHERS
    match /teachers/{teacherId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && getUserRole() == 'admin';
    }

    // PARENTS
    match /parents/{parentId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && getUserRole() == 'admin';
    }
  }
}
